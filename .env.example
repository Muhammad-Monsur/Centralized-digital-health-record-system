# Local development settings (Windows). NEVER commit .env.
APP_ENV=development
DEBUG=false
SECRET_KEY=t0h1kvejtAUwqNGCBYfXPl_olqaIo6Z81V46QySvvo_9fNN6Mk0FKDl8mbOO9zkj
BASE_URL=http://localhost:8000
DISPLAY_TIMEZONE=Asia/Dhaka

# MySQL 8 on this computer, app user "cdhrs"
DATABASE_URL=mysql+pymysql://cdhrs:CdhrsApp2026@127.0.0.1:3306/cdhrs?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://cdhrs:CdhrsApp2026@127.0.0.1:3306/cdhrs_test?charset=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
SQL_ECHO=false

# Empty = built-in in-memory store (fine for one app process on this computer).
# Only needed for the Docker / multi-server setup: redis://:YOUR_PASSWORD@127.0.0.1:6379/0
REDIS_URL=
# REDIS_PASSWORD=change-me-redis

# Sessions (false is correct for http://localhost; must be true behind HTTPS)
SESSION_IDLE_TIMEOUT_MINUTES=15
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
COOKIE_SECURE=false

# Sign-in lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Consent codes and access durations
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
CONSENT_DEFAULT_HOURS=24
EMERGENCY_ACCESS_MINUTES=60

# console = SMS codes are printed in the terminal running the app
SMS_PROVIDER=console
SMS_HTTP_URL=
SMS_HTTP_API_KEY=
SMS_HTTP_SENDER_ID=CDHRS

# Files
UPLOAD_DIR=storage/uploads
BACKUP_DIR=storage/backups
MAX_UPLOAD_MB=10

# Static files (no CDN, no build step needed for development)
STATIC_URL_PREFIX=/static
USE_BUILT_ASSETS=false

# API docs at http://localhost:8000/api/docs (empty = on in development)
ENABLE_API_DOCS=